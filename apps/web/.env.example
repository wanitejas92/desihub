# Copy to .env.local. Without these, the app runs on the in-memory mock catalogue.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Checkout (Phase 3). Without these, orders are paid instantly and free of
# charge (demo mode) — see README.md#checkout.
# Ticket issuance has no client-facing RLS insert policy on purpose; only
# server code with the service-role key can write to `tickets`.
SUPABASE_SERVICE_ROLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Footer social icons and the floating WhatsApp contact button. Each one is
# invisible until its URL/number is set — an icon linking nowhere is worse
# than no icon.
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_YOUTUBE_URL=
NEXT_PUBLIC_TIKTOK_URL=
# Digits only (country code + number, no + or spaces), e.g. 31612345678
NEXT_PUBLIC_WHATSAPP_NUMBER=

# "Sign in with Google" button, on the sign-in modal and page. Set to "true"
# only after configuring a Google provider (real OAuth client ID/secret) in
# the Supabase dashboard: Authentication → Providers → Google. Until then,
# leave unset — calling signInWithOAuth against an unconfigured provider
# fails with a 400 "Unsupported provider" error.
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=
