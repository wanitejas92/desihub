# Copy to .env.local. Without these, the app runs on the in-memory mock catalogue.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Checkout (Phase 3). Without these, orders are paid instantly and free of
# charge (demo mode) — see README.md#checkout.
# Ticket issuance has no client-facing RLS insert policy on purpose; only
# server code with the service-role key can write to `tickets`.
SUPABASE_SERVICE_ROLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
